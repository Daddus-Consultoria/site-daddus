# Strapi — publicacoes, blog, autores, painel e proxy admin.
# As duas sao necessarias: sem a segunda o acervo volta vazio em silencio.
NEXT_PUBLIC_STRAPI_URL=
NEXT_PUBLIC_STRAPI_API_URL=

# Base usada pelo ChartAPIService para chamar /state-*-charts.
NEXT_PUBLIC_SITE_API_URL=

# Iframe de BI em /indicadores.
NEXT_PUBLIC_BI_URL=

# GA (opcional).
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Google Sheets — graficos e mapas.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Postgres da Biblioteca Daddus (busca, filtros e coleta de metadados).
# Producao: string de conexao do provedor gerenciado.
# Desenvolvimento: ver docs/BIBLIOTECA.md para subir o container local.
DATABASE_URL=
